<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#11110f">
  <title>AFTER HOURS — A Midnight Journal</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

  <style>
    :root {
      color-scheme: dark;
      --bg: #11110f;
      --panel: #191916;
      --panel-hover: #201f1b;
      --border: #302e28;
      --text: #e9e4d9;
      --muted: #89877d;
      --amber: #d9a779;
      --amber-light: #f0c59c;
      --danger: #d88980;
      --serif: "Playfair Display", Georgia, serif;
      --sans: "DM Sans", sans-serif;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(ellipse at 50% 0%, #4c34201c 0%, transparent 52%),
        var(--bg);
      color: var(--text);
      font-family: var(--sans);
      font-size: 14px;
      line-height: 1.6;
    }

    button, input, textarea { font: inherit; }
    button { cursor: pointer; }
    button:focus-visible, input:focus-visible,
    textarea:focus-visible {
      outline: 2px solid var(--amber);
      outline-offset: 3px;
    }

    .shell {
      width: min(1100px, calc(100% - 40px));
      margin: auto;
    }

    header {
      height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid #ffffff0b;
    }

    .brand {
      color: var(--amber);
      letter-spacing: 4px;
      font-size: 12px;
      font-weight: 700;
    }

    .brand span {
      display: block;
      margin-top: -4px;
      color: var(--muted);
      font-size: 9px;
      letter-spacing: 2px;
      font-weight: 400;
    }

    .clock {
      text-align: right;
      color: var(--muted);
      font-size: 11px;
      letter-spacing: 1px;
    }

    main { padding: 66px 0 80px; }

    .intro { margin-bottom: 38px; }

    .eyebrow {
      color: var(--amber);
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: 10px;
      font-weight: 600;
    }

    h1 {
      font: 400 clamp(38px, 6vw, 62px)/1.15 var(--serif);
      letter-spacing: -1.7px;
      margin: 15px 0 12px;
    }

    h1 em { color: var(--amber); font-weight: 400; }

    .subtitle { color: var(--muted); margin: 0; }

    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1.55fr) minmax(260px, .85fr);
      gap: 24px;
      align-items: start;
    }

    .panel {
      border: 1px solid var(--border);
      border-radius: 10px;
      background: linear-gradient(145deg, #1b1a16, #151512);
      padding: 25px;
      min-width: 0;
    }

    .panel-heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 22px;
    }

    h2 {
      font: 400 23px var(--serif);
      margin: 0;
    }

    .tiny { color: var(--muted); font-size: 11px; }

    .field { margin-bottom: 21px; }

    label, .field-label {
      display: block;
      color: #b4b0a4;
      font-size: 11px;
      margin-bottom: 8px;
      letter-spacing: .5px;
    }

    input[type="text"], textarea {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: #11110f;
      color: var(--text);
      padding: 12px 13px;
      transition: border-color .2s, background .2s;
    }

    input::placeholder, textarea::placeholder { color: #626057; }

    input:focus, textarea:focus {
      outline: none;
      border-color: #9f7852;
      background: #14130f;
    }

    #entryTitle {
      font: 400 20px var(--serif);
    }

    textarea {
      min-height: 190px;
      resize: vertical;
      line-height: 1.9;
    }

    .moods {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .mood {
      border: 1px solid var(--border);
      background: transparent;
      color: #b6b1a6;
      padding: 7px 10px;
      border-radius: 30px;
      font-size: 11px;
      transition: .2s;
    }

    .mood:hover { background: var(--panel-hover); }

    .mood.selected {
      border-color: var(--amber);
      background: #d9a77916;
      color: var(--amber-light);
    }

    .song-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 26px;
    }

    .btn {
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 10px 15px;
      color: var(--text);
      background: transparent;
      transition: .2s;
    }

    .btn:hover { background: var(--panel-hover); }

    .btn-primary {
      background: var(--amber);
      border-color: var(--amber);
      color: #1a1510;
      font-weight: 700;
    }

    .btn-primary:hover { background: var(--amber-light); }

    .btn-danger { color: var(--danger); }

    .side { display: grid; gap: 20px; }

    .quote {
      color: #bcb5a6;
      font: italic 20px/1.65 var(--serif);
      margin: 15px 0 0;
    }

    .quote-mark {
      color: var(--amber);
      font: 34px var(--serif);
      line-height: 1;
    }

    .divider {
      border: 0;
      border-top: 1px solid var(--border);
      margin: 22px 0;
    }

    .stat-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 10px 0;
      color: var(--muted);
      font-size: 12px;
    }

    .stat-row strong { color: var(--text); font-weight: 500; }

    .archive { margin-top: 44px; }

    .archive-head {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 20px;
      margin-bottom: 20px;
    }

    .archive-head h2 { font-size: 30px; margin-top: 6px; }

    .search {
      width: min(280px, 100%);
      font-size: 12px;
    }

    .entries {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .entry-card {
      padding: 20px;
      background: #171714;
      border: 1px solid var(--border);
      border-radius: 8px;
      min-width: 0;
      transition: border-color .2s, transform .2s;
    }

    .entry-card:hover {
      border-color: #62503b;
      transform: translateY(-2px);
    }

    .entry-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      align-items: center;
      color: var(--muted);
      font-size: 10px;
      margin-bottom: 12px;
    }

    .entry-mood { color: var(--amber); }

    .entry-card h3 {
      font: 400 22px var(--serif);
      overflow-wrap: anywhere;
      margin: 0 0 9px;
    }

    .entry-text {
      color: #aaa69b;
      font-size: 12px;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      display: -webkit-box;
      -webkit-line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .entry-song {
      margin-top: 16px;
      color: var(--amber-light);
      font-size: 11px;
      overflow-wrap: anywhere;
    }

    .card-actions {
      display: flex;
      gap: 14px;
      margin-top: 18px;
      border-top: 1px solid #ffffff0b;
      padding-top: 12px;
    }

    .text-btn {
      background: none;
      border: 0;
      padding: 2px 0;
      color: var(--muted);
      font-size: 11px;
    }

    .text-btn:hover { color: var(--amber); }
    .text-btn.delete:hover { color: var(--danger); }

    .empty {
      grid-column: 1 / -1;
      text-align: center;
      padding: 42px 20px;
      border: 1px dashed var(--border);
      border-radius: 8px;
      color: var(--muted);
    }

    .empty .symbol { font: 34px var(--serif); color: var(--amber); }
    .empty p { margin-bottom: 0; }

    footer {
      border-top: 1px solid #ffffff0b;
      padding: 24px 0;
      text-align: center;
      color: #66645c;
      font-size: 10px;
      letter-spacing: 1px;
    }

    .toast {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translate(-50%, 20px);
      opacity: 0;
      pointer-events: none;
      background: #25231d;
      border: 1px solid #51432f;
      color: var(--text);
      border-radius: 6px;
      padding: 12px 18px;
      font-size: 12px;
      transition: .25s;
      z-index: 10;
      max-width: calc(100% - 30px);
    }

    .toast.show { opacity: 1; transform: translate(-50%, 0); }

    .privacy {
      font-size: 10px;
      line-height: 1.7;
      color: var(--muted);
    }

    @media (max-width: 760px) {
      main { padding-top: 42px; }
      .layout { grid-template-columns: 1fr; }
      .side { grid-template-columns: 1fr 1fr; }
      .entries { grid-template-columns: 1fr; }
    }

    @media (max-width: 480px) {
      .shell { width: calc(100% - 26px); }
      .panel { padding: 18px; }
      .side { grid-template-columns: 1fr; }
      .song-row { grid-template-columns: 1fr; }
      .archive-head { align-items: stretch; flex-direction: column; }
      .search { width: 100%; }
      h1 { letter-spacing: -1px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>

<body>
  <header class="shell">
    <div class="brand">
      AFTER HOURS
      <span>A JOURNAL FOR THE IN-BETWEEN</span>
    </div>
    <div class="clock">
      <div id="clockTime">12:00 AM</div>
      <div id="clockDate">A QUIET MOMENT</div>
    </div>
  </header>

  <main class="shell">
    <section class="intro">
      <div class="eyebrow">Your own little corner of the world</div>
      <h1>Somewhere between<br>the noise and <em>the quiet.</em></h1>
      <p class="subtitle">A place to leave your thoughts before the night disappears.</p>
    </section>

    <div class="layout">
      <section class="panel" id="editorPanel">
        <div class="panel-heading">
          <h2 id="editorHeading">Capture this moment</h2>
          <span class="tiny" id="wordCount">0 words</span>
        </div>

        <form id="journalForm">
          <div class="field">
            <label for="entryTitle">GIVE THIS MOMENT A NAME</label>
            <input id="entryTitle" type="text" maxlength="120"
              placeholder="A night I want to remember...">
          </div>

          <div class="field">
            <label for="thoughts">WHAT'S ON YOUR MIND?</label>
            <textarea id="thoughts" maxlength="20000"
              placeholder="Don't worry about making sense. Just start somewhere..."></textarea>
          </div>

          <div class="field">
            <span class="field-label">HOW DOES TONIGHT FEEL?</span>
            <div class="moods" id="moods">
              <button type="button" class="mood" data-mood="Calm">☁ Calm</button>
              <button type="button" class="mood" data-mood="Happy">☀ Happy</button>
              <button type="button" class="mood" data-mood="Nostalgic">☾ Nostalgic</button>
              <button type="button" class="mood" data-mood="Hopeful">✧ Hopeful</button>
              <button type="button" class="mood" data-mood="Melancholic">🌧 Melancholic</button>
              <button type="button" class="mood" data-mood="Energized">↗ Energized</button>
              <button type="button" class="mood" data-mood="Overwhelmed">〰 Overwhelmed</button>
              <button type="button" class="mood" data-mood="Unsure">… Unsure</button>
            </div>
          </div>

          <div class="field">
            <span class="field-label">THE SOUNDTRACK TO THIS MOMENT</span>
            <div class="song-row">
              <div>
                <label for="song" class="tiny">SONG TITLE</label>
                <input id="song" type="text" maxlength="200"
                  placeholder="The track on repeat">
              </div>
              <div>
                <label for="artist" class="tiny">ARTIST</label>
                <input id="artist" type="text" maxlength="150"
                  placeholder="Who made it?">
              </div>
            </div>
          </div>

          <div class="actions">
            <button type="button" class="btn" id="clearBtn">Clear</button>
            <button type="submit" class="btn btn-primary" id="saveBtn">Save this moment ↗</button>
          </div>
        </form>
      </section>

      <aside class="side">
        <section class="panel">
          <div class="eyebrow">A little reminder</div>
          <div class="quote-mark">“</div>
          <p class="quote" id="promptText">You don't have to figure everything out tonight.</p>
          <hr class="divider">
          <button type="button" class="text-btn" id="newPrompt">Another thought ↗</button>
        </section>

        <section class="panel">
          <div class="eyebrow">Your nights, collected</div>
          <h2 style="margin-top: 12px;">Little memories.</h2>
          <hr class="divider">
          <div class="stat-row">
            <span>Moments saved</span>
            <strong id="entryCount">0</strong>
          </div>
          <div class="stat-row">
            <span>Words written</span>
            <strong id="totalWords">0</strong>
          </div>
          <div class="stat-row">
            <span>Most recent</span>
            <strong id="lastSaved">Not yet</strong>
          </div>
          <hr class="divider">
          <p class="privacy">Your entries stay in this browser on this device. They are not uploaded or synced. Export your memories for a backup.</p>
          <button type="button" class="btn" id="exportBtn" style="width:100%; margin-top:8px;">Export memories ↓</button>
        </section>
      </aside>
    </div>

    <section class="archive">
      <div class="archive-head">
        <div>
          <div class="eyebrow">Pages from your past</div>
          <h2>Your midnight archive</h2>
          <div class="tiny" id="archiveSubtitle">Every moment has a place here.</div>
        </div>
        <input class="search" id="searchInput" type="text"
          placeholder="Search thoughts, moods, songs..." aria-label="Search journal entries">
      </div>
      <div class="entries" id="entries"></div>
    </section>
  </main>

  <footer class="shell">MADE IN THE QUIET HOURS · AFTER HOURS</footer>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    const STORAGE_KEY = "after-hours-journal-v1";

    const $ = (selector) => document.querySelector(selector);

    const form = $("#journalForm");
    const titleInput = $("#entryTitle");
    const thoughtsInput = $("#thoughts");
    const songInput = $("#song");
    const artistInput = $("#artist");
    const entriesContainer = $("#entries");
    const searchInput = $("#searchInput");
    const saveBtn = $("#saveBtn");

    let selectedMood = "";
    let editingId = null;
    let toastTimer;
    let entries = loadEntries();

    const prompts = [
      "You don't have to figure everything out tonight.",
      "What felt different about today?",
      "What song sounds like the life you're living right now?",
      "What would you tell yourself a year ago?",
      "What is one small thing you are grateful for?",
      "If tonight had a color, what would it be?",
      "What are you ready to leave behind?",
      "What do you hope your future self remembers?"
    ];

    function loadEntries() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        const parsed = saved ? JSON.parse(saved) : [];
        return Array.isArray(parsed) ? parsed : [];
      } catch (error) {
        console.error("Could not read journal storage:", error);
        return [];
      }
    }

    function persistEntries() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(entries));
        return true;
      } catch (error) {
        console.error("Could not save journal:", error);
        showToast("Couldn't save. Browser storage may be full or unavailable.");
        return false;
      }
    }

    function showToast(message) {
      const toast = $("#toast");
      toast.textContent = message;
      toast.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove("show"), 2800);
    }

    function wordCount(text) {
      const trimmed = text.trim();
      return trimmed ? trimmed.split(/\s+/).length : 0;
    }

    function updateWordCount() {
      $("#wordCount").textContent = wordCount(thoughtsInput.value) + " words";
    }

    function updateClock() {
      const now = new Date();
      $("#clockTime").textContent = now.toLocaleTimeString([], {
        hour: "2-digit", minute: "2-digit"
      }).toUpperCase();
      $("#clockDate").textContent = now.toLocaleDateString([], {
        weekday: "long", month: "short", day: "numeric"
      }).toUpperCase();
    }

    function formatDate(dateString) {
      const date = new Date(dateString);
      if (Number.isNaN(date.getTime())) return "A saved moment";
      return date.toLocaleString([], {
        month: "short", day: "numeric", year: "numeric",
        hour: "numeric", minute: "2-digit"
      });
    }

    function escapeHTML(value) {
      return String(value).replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      })[char]);
    }

    function selectMood(mood) {
      selectedMood = mood;
      document.querySelectorAll(".mood").forEach(button => {
        const selected = button.dataset.mood === mood;
        button.classList.toggle("selected", selected);
        button.setAttribute("aria-pressed", String(selected));
      });
    }

    $("#moods").addEventListener("click", event => {
      const button = event.target.closest("[data-mood]");
      if (button) selectMood(selectedMood === button.dataset.mood ? "" : button.dataset.mood);
    });

    thoughtsInput.addEventListener("input", updateWordCount);

    function clearEditor() {
      form.reset();
      editingId = null;
      selectMood("");
      updateWordCount();
      $("#editorHeading").textContent = "Capture this moment";
      saveBtn.textContent = "Save this moment ↗";
    }

    $("#clearBtn").addEventListener("click", () => {
      clearEditor();
      showToast("Ready for a fresh thought.");
    });

    form.addEventListener("submit", event => {
      event.preventDefault();

      const thoughts = thoughtsInput.value.trim();
      if (!thoughts) {
        showToast("Write a little something before saving.");
        thoughtsInput.focus();
        return;
      }

      const now = new Date().toISOString();
      const existing = editingId
        ? entries.find(entry => entry.id === editingId)
        : null;

      const entry = {
        id: editingId || (crypto.randomUUID
          ? crypto.randomUUID()
          : String(Date.now()) + Math.random().toString(16).slice(2)),
        title: titleInput.value.trim() || "An untitled moment",
        thoughts,
        mood: selectedMood,
        song: songInput.value.trim(),
        artist: artistInput.value.trim(),
        createdAt: existing ? existing.createdAt : now,
        updatedAt: now
      };

      const previousEntries = entries.slice();

      if (editingId) {
        entries = entries.map(item => item.id === editingId ? entry : item);
      } else {
        entries.unshift(entry);
      }

      if (!persistEntries()) {
        entries = previousEntries;
        return;
      }

      render();
      clearEditor();
      showToast(existing ? "Your memory has been updated." : "This moment is yours now.");
      $("#entries").scrollIntoView({ behavior: "smooth", block: "nearest" });
    });

    function editEntry(id) {
      const entry = entries.find(item => item.id === id);
      if (!entry) return;

      editingId = id;
      titleInput.value = entry.title === "An untitled moment" ? "" : entry.title;
      thoughtsInput.value = entry.thoughts;
      songInput.value = entry.song || "";
      artistInput.value = entry.artist || "";
      selectMood(entry.mood || "");
      updateWordCount();

      $("#editorHeading").textContent = "Revisit this moment";
      saveBtn.textContent = "Update this moment ↗";
      $("#editorPanel").scrollIntoView({ behavior: "smooth", block: "start" });
      thoughtsInput.focus({ preventScroll: true });
    }

    function deleteEntry(id) {
      const entry = entries.find(item => item.id === id);
      if (!entry) return;

      if (!confirm("Delete this memory permanently from this browser?")) return;

      const previousEntries = entries.slice();
      entries = entries.filter(item => item.id !== id);

      if (!persistEntries()) {
        entries = previousEntries;
        return;
      }

      if (editingId === id) clearEditor();
      render();
      showToast("Memory deleted.");
    }

    function render() {
      const query = searchInput.value.trim().toLowerCase();

      const filtered = entries.filter(entry => [
        entry.title, entry.thoughts, entry.mood, entry.song, entry.artist
      ].some(value => String(value || "").toLowerCase().includes(query)));

      $("#entryCount").textContent = entries.length;
      $("#totalWords").textContent = entries.reduce(
        (total, entry) => total + wordCount(entry.thoughts), 0
      );

      $("#lastSaved").textContent = entries.length
        ? new Date(entries[0].updatedAt || entries[0].createdAt)
            .toLocaleDateString([], { month: "short", day: "numeric" })
        : "Not yet";

      $("#archiveSubtitle").textContent = query
        ? `${filtered.length} matching ${filtered.length === 1 ? "moment" : "moments"}`
        : `${entries.length} ${entries.length === 1 ? "moment" : "moments"} collected so far.`;

      if (!filtered.length) {
        entriesContainer.innerHTML = `
          <div class="empty">
            <div class="symbol">${query ? "⌕" : "☾"}</div>
            <h3>${query ? "Nothing found just yet." : "Your story starts here."}</h3>
            <p>${query
              ? "Try another word, mood, or song."
              : "Write down what's on your mind. You can come back to it someday."}</p>
          </div>`;
        return;
      }

      entriesContainer.innerHTML = filtered.map(entry => {
        const songLine = [entry.song, entry.artist].filter(Boolean).join(" — ");

        return `
          <article class="entry-card">
            <div class="entry-meta">
              <span>${escapeHTML(formatDate(entry.createdAt))}</span>
              ${entry.mood ? `<span class="entry-mood">✧ ${escapeHTML(entry.mood)}</span>` : ""}
            </div>
            <h3>${escapeHTML(entry.title)}</h3>
            <div class="entry-text">${escapeHTML(entry.thoughts)}</div>
            ${songLine
              ? `<div class="entry-song">♫ &nbsp;${escapeHTML(songLine)}</div>`
              : ""}
            <div class="card-actions">
              <button class="text-btn" data-action="edit" data-id="${escapeHTML(entry.id)}">Edit memory</button>
              <button class="text-btn delete" data-action="delete" data-id="${escapeHTML(entry.id)}">Delete</button>
            </div>
          </article>`;
      }).join("");
    }

    entriesContainer.addEventListener("click", event => {
      const button = event.target.closest("[data-action]");
      if (!button) return;

      if (button.dataset.action === "edit") editEntry(button.dataset.id);
      if (button.dataset.action === "delete") deleteEntry(button.dataset.id);
    });

    searchInput.addEventListener("input", render);

    $("#newPrompt").addEventListener("click", () => {
      const current = $("#promptText").textContent;
      const choices = prompts.filter(prompt => prompt !== current);
      $("#promptText").textContent = choices[Math.floor(Math.random() * choices.length)];
    });

    $("#exportBtn").addEventListener("click", () => {
      const backup = {
        app: "AFTER HOURS",
        exportedAt: new Date().toISOString(),
        entries
      };

      const blob = new Blob([JSON.stringify(backup, null, 2)], {
        type: "application/json"
      });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = `after-hours-memories-${new Date().toISOString().slice(0, 10)}.json`;
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      showToast("Your memories backup is ready.");
    });

    updateClock();
    setInterval(updateClock, 30000);
    render();
  </script>
</body>
</html>
